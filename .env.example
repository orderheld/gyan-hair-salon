# Kopieren nach .env.local und ausfüllen. Dieselben Werte in Vercel unter Settings > Environment Variables eintragen.

# Neon: Dashboard > Connect > Connection string (mit ?sslmode=require)
# Leer lassen, um lokal mit der eingebauten Test-Datenbank zu arbeiten.
DATABASE_URL=

# Resend: API Key (https://resend.com/api-keys)
RESEND_API_KEY=
# Absender, Domain muss in Resend verifiziert sein
EMAIL_FROM="GYAN Hair Salon <termine@gyan-hairsalon.ch>"
# Hierhin gehen Benachrichtigungen über neue Termine (z. B. Zanas E-Mail)
SALON_NOTIFY_EMAIL=

# Admin-Panel unter /admin
ADMIN_PASSWORD=
# Zufälliger langer Wert für die Login-Sitzung
ADMIN_SECRET=

# Öffentliche Adresse der Seite (für Links in E-Mails)
NEXT_PUBLIC_SITE_URL=https://www.gyan-hairsalon.ch

# Schlüssel für Erinnerungs- und Feedback-E-Mails (cron-job.org ruft /api/cron?key=… auf)
CRON_SECRET=
